# 复制为 .env 后填写。
# 所有变量都可以留空。未配置生成模型时，系统会用检索结果做保守摘要；
# 未配置嵌入模型和 Qdrant 时，自动退回纯关键词检索。

# 生成模型，兼容 DeepSeek、OpenAI 等接口
RAG_GENERATION_API_KEY=
RAG_GENERATION_BASE_URL=https://api.deepseek.com
RAG_GENERATION_MODEL=deepseek-chat

# 嵌入模型，兼容 SiliconFlow、OpenAI 等接口
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
RAG_EMBEDDING_MODEL=BAAI/bge-m3
RAG_EMBEDDING_DIM=1024

# 可选：Rerank 模型
RAG_RERANK_API_KEY=
RAG_RERANK_BASE_URL=https://api.siliconflow.cn/v1
RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3

# Qdrant 向量库
RAG_QDRANT_URL=http://127.0.0.1:6333
RAG_QDRANT_API_KEY=
RAG_QDRANT_COLLECTION_PREFIX=rag
RAG_QDRANT_PREFER_GRPC=false

# Redis 缓存与熔断降级
RAG_REDIS_URL=redis://127.0.0.1:6379/0
RAG_CACHE_TTL_SECONDS=300
RAG_BLOOM_CAPACITY=100000
RAG_BLOOM_ERROR_RATE=0.01
RAG_CIRCUIT_FAILURE_THRESHOLD=5
RAG_CIRCUIT_RECOVERY_TIMEOUT_SECONDS=30

# 用户与三级权限：admin / editor / viewer
RAG_ADMIN_USERNAME=korce
RAG_ADMIN_PASSWORD=change-me
RAG_JWT_SECRET=change-me-in-production
RAG_JWT_ALGORITHM=HS256
RAG_TOKEN_EXPIRE_MINUTES=720

# Prompt 版本，默认 latest；也可以指定如 1.0.0
RAG_PROMPT_VERSION=latest

# Guard 安全校验
RAG_GUARD_MAX_INPUT_LENGTH=2000
RAG_GUARD_MAX_OUTPUT_LENGTH=8000
RAG_GUARD_UPLOAD_MAX_BYTES=20971520

# 分块与检索
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=80
RAG_TOP_K=5
RAG_RRF_K=60

# 数据目录，默认为项目下的 data
# RAG_DATA_DIR=./data

# 可选：兼容旧的静态访问令牌。设置后仍可用 Bearer token 访问。
RAG_AUTH_TOKEN=

